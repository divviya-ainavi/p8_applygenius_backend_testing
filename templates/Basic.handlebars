  <body lang="EN-IN" style="word-wrap: break-word">
    <div class="WordSection1">
      <table
        class="MsoNormalTable"
        border="0"
        cellspacing="0"
        cellpadding="0"
        width="100%"
      >
        <tr>
          <!-- Left Column -->
          <td width="252" valign="top" style="padding: 25.2pt 36pt 0cm 0cm">
            <p class="Initials">{{initials}}</p>

            <div
              style="border-bottom: solid #ea4e4e 6pt; padding: 0cm 0cm 1pt 0cm"
            >
              <h3>Summary</h3>
            </div>
            <p class="MsoNormal">{{summary}}</p>

            <div
              style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
            >
              <h3>Skills</h3>
            </div>
            {{#each skills}}
              <p class="MsoNormal">{{this}}</p>
            {{/each}}
          </td>

          <!-- Right Column -->
          <td width="449" valign="top" style="padding: 25.2pt 0cm 0cm 0cm">
            <table
              class="MsoTableGrid"
              border="0"
              cellspacing="0"
              cellpadding="0"
              width="100%"
              style="border: none"
            >
              <tr style="height: 57.6pt">
                <td style="padding: 0cm 21.6pt 48.25pt 0cm;">
                  <h1 style="text-align: left">{{name}}</h1>
                  <h2 style="text-align: left">
                    {{location}}
                    {{email}}
                    {{phoneNumber}}
                    {{jobTitle}}
                    {{linkedin}}
                  </h2>
                </td>
              </tr>
            </table>

            <!-- Experience -->
            {{#if experience.length}}
              <div
                style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
              >
                <h3>Experience</h3>
              </div>
              {{#each experience}}
                <h4>
                  <strong>
                    {{title}}
                    {{#if company}} ● {{company}}{{/if}}
                    {{#if duration}} ● {{duration}}{{/if}}
                  </strong>
                </h4>
                {{#each responsibilities}}
                  <p class="MsoNormal">{{this}}</p>
                {{/each}}
              {{/each}}
            {{/if}}

            <!-- Education -->
            {{#if education.length}}
              <div
                style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
              >
                <h3>Education</h3>
              </div>
              {{#each education}}
                <h4>
                  <strong>
                    {{degree}}
                    {{#if year}} ● {{year}}{{/if}}
                    {{#if institution}} ● {{institution}}{{/if}}
                  </strong>
                </h4>
                <p class="MsoNormal">{{score}}</p>
              {{/each}}
            {{/if}}

            <!-- Custom Sections -->
            {{#if customsections.length}}
              {{#each customsections}}
                <div
                  style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
                >
                  <h3>{{title}}</h3>
                </div>
                {{#each items}}
                  <h4>
                    <strong>
                      {{title}}
                      {{#if date}} ● {{date}}{{/if}}
                      {{#if location}} ● {{location}}{{/if}}
                    </strong>
                  </h4>
                  <p class="MsoNormal">{{description}}</p>
                {{/each}}
              {{/each}}
            {{/if}}
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>