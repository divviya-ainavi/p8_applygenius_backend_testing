  <body lang="EN-IN" style="word-wrap: break-word;">
    <div class="WordSection1">

      <table
        width="100%"
        cellpadding="0"
        cellspacing="0"
        style="
          border-collapse: collapse;
         margin-top: 40px;
          margin-left: 25px;
        "
      >
        <tr>
          <!-- Red Bar Section with visible overflow -->
          <td
            style="
              background-color: #ea4e4e;
              padding: 25px 30px;
              position: relative;
              overflow: visible; /* 👈 Key Fix */
            "
          >
            <div style="display: flex; align-items: center; position: relative">
              <!-- Initials Circle -->
              <div
                style="
                  position: absolute;
                  left: -60px;
                  width: 150px;
                  height: 150px;
                  background-color: white;
                  border: 4px solid #ea4e4e;
                  border-radius: 50%;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-family: 'Franklin Gothic Demi', sans-serif;
                  font-size: 32pt;
                  font-weight: bold;
                  color: #ea4e4e;
                  z-index: 10;
                "
              >
                {{initials}}
              </div>

              <!-- Text Content (Right-Aligned) -->
              <div style="flex: 1; text-align: right; padding-left: 80px">
                <div
                  style="
                    font-family: 'Franklin Gothic Demi', sans-serif;
                    font-size: 16pt;
                    font-weight: bold;
                    color: black;
                    text-transform: uppercase;
                  "
                >
                  {{name}}
                </div>
                <div
                  style="
                    font-family: Rockwell, serif;
                    font-size: 9.5pt;
                    text-transform: uppercase;
                    color: black;
                    margin-top: 4px;
                  "
                >
                  {{location}}
                  |
                  {{email}}
                  |
                  {{phoneNumber}}
                  |
                  {{jobTitle}}
                </div>
              </div>
            </div>
          </td>
        </tr>
      </table>

      <table
        class="MsoNormalTable"
        border="0"
        cellspacing="0"
        cellpadding="0"
        width="100%"
      >
        <tr>
          <!-- Left Column -->
          <td width="252" valign="top" style="padding: 25.2pt 36pt 0cm 0cm">

            <div
              style="border-bottom: solid #ea4e4e 6pt; padding: 0cm 0cm 1pt 0cm"
            >
              <h3>Summary</h3>
            </div>
            <p class="MsoNormal" style="line-height: 1.6;">{{summary}}</p>

            <div
              style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
            >
              <h3>Skills</h3>
            </div>
            {{#each skills}}
              <p class="MsoNormal">{{this}}</p>
            {{/each}}
          </td>

          <!-- Right Column -->
          <td width="449" valign="top" style="padding: 25.2pt 0cm 0cm 0cm">

            <!-- Experience -->
            {{#if experience.length}}
              <div
                style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
              >
                <h3>Experience</h3>
              </div>
              {{#each experience}}
                <h4>

                  {{title}}
                  {{#if company}}
                    <span style="font-size: 10px;">●</span>
                    {{company}}{{/if}}
                  {{#if duration}}
                    <span style="font-size: 10px;">●</span>
                    {{duration}}{{/if}}

                </h4>
                {{#each responsibilities}}
                  <p
                    class="MsoNormal experience-block"
                    style="line-height: 1.6;"
                  >{{this}}</p>
                {{/each}}
              {{/each}}
            {{/if}}

            <!-- Education -->
            {{#if education.length}}
              <div
                style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
              >
                <h3>Education</h3>
              </div>
              {{#each education}}
                <h4>

                  {{degree}}
                  {{#if year}}
                    <span style="font-size: 10px;">●</span>
                    {{year}}{{/if}}
                  {{#if institution}}
                    <span style="font-size: 10px;">●</span>
                    {{institution}}{{/if}}

                </h4>
                <p class="MsoNormal education-block">{{score}}</p>
              {{/each}}
            {{/if}}

            <!-- Custom Sections -->
            {{#if customsections.length}}
              {{#each customsections}}
                <div
                  style="border-bottom:solid #EA4E4E 6pt;padding:0cm 0cm 1pt 0cm"
                >
                  <h3>{{title}}</h3>
                </div>
                {{#each items}}
                  {{#if (or title date location)}}
                    <h4>
                      {{#if title}}{{title}}{{/if}}
                      {{#if date}}
                        <span style="font-size: 10px;">●</span>
                        {{date}}
                      {{/if}}
                      {{#if location}}
                        <span style="font-size: 10px;">●</span>
                        {{location}}
                      {{/if}}
                    </h4>
                  {{/if}}

                  <p class="MsoNormal custom-block">{{description}}</p>
                {{/each}}
              {{/each}}
            {{/if}}
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>