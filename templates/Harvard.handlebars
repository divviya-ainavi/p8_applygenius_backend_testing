<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{name}} Resume</title>
    <style>
      body { font-family: Arial, sans-serif; background-color: #fff; color:
      #000; line-height: 1.6; } p { margin: 0px 100px 0px 0px; }
      .resume-container { max-width: 800px; margin: auto; background: #fff;
      padding: 20px; } .header { text-align: center; font-size: 24px;
      font-weight: bold; color: #000; margin-bottom: 10px; } .contact-info {
      display: flex; flex-wrap: wrap; /* Allows wrapping only when needed */
      align-items: center; justify-content: center; gap: 15px; font-size: 16px;
      color: #000; text-align: center; } .contact-info a { color: #4da6ff;
      text-decoration: none; word-break: break-word; /* Ensures long text (like
      links) wraps */ } .contact-info a:hover { text-decoration: underline; }
      .icon { font-size: 14px; margin-right: 5px; } /* Ensure each item doesn't
      take too much space */ .contact-info > * { flex-shrink: 1; /* Prevents
      elements from stretching too much */ min-width: auto; max-width: 100%; /*
      Ensures the items stay within bounds */ text-align: center; } hr { border:
      1px solid #555; } .section-title { margin-bottom: 10px; padding-bottom:
      15px; border-bottom: 1px solid #d4d4d4; font-size: 20px; font-weight:
      bold; color: #000; } .info { font-size: 16px; color: #000; }
      .experience-item, .skills-list { margin-bottom: 20px; } .experience-item
      h4 { margin: 5px 0; display: flex; justify-content: space-between; }
      .experience-dates { font-weight: bold; } .skills-container { display:
      flex; flex-wrap: wrap; justify-content: space-between; padding: 10px 0; }
      .skills-column { width: 30%; text-align: left; font-weight: bold; padding:
      5px 0; } .bullet-list { list-style: none; /* Remove default bullets */
      padding-left: 20px; /* Maintain indentation */ } .bullet-list li {
      position: relative; padding-left: 20px; /* Space for the custom bullet */
      margin-bottom: 5px; /* Space between bullet points */ } .bullet-list
      li::before { content: "●"; /* Unicode bullet symbol */ color: black; /*
      Change this to your desired bullet color */ font-size: 10px; /* Adjust
      bullet size */ position: absolute; left: 0; top: 5; } .education-item {
      display: flex; flex-direction: column; /* Stack items vertically */ }
      .education-details { display: flex; justify-content: space-between; /*
      Degree on the left, Date on the right */ align-items: center; }
      .education-dates { white-space: nowrap; /* Prevent wrapping */ text-align:
      right; /* Align text to the right */ min-width: 120px; /* Ensures
      consistent width */ color: #555; /* Subtle color */ }
    </style>
  </head>
  <body>
    <div class="resume-container">
      <div class="header">{{name}}</div>
      <div class="contact-info">
        {{#if location}}<span>{{location}}</span>{{/if}}
        {{#if email}}<span>
            {{! <span class="icon">✉️</span> }}
            {{email}}</span>{{/if}}
        {{#if phoneNumber}}<span>
            {{! <span
              class="icon"
            >📞</span> }}
            {{phoneNumber}}</span>{{/if}}
        {{#if jobTitle}}<strong>{{jobTitle}}</strong>{{/if}}
        {{#if linkedinProfile}}<span>
            {{! <span
              class="icon"
            >🔗</span> }}
            {{linkedinProfile}}</span>{{/if}}
      </div>
      <br />
      <hr />

      {{#if summary}}
        <h2 class="section-title">SUMMARY</h2>
        <p>{{summary}}</p>
        <br />
        <hr />
      {{/if}}

      {{#if experience.length}}
        <h2 class="section-title">EXPERIENCE</h2>
        {{#each experience}}
          <div class="experience-item">
            <h4>
              {{title}}{{#if company}} | {{company}}{{/if}}
              <span class="experience-dates">{{duration}}</span>
            </h4>
            {{#if responsibilities.length}}
              <ul class="bullet-list">
                {{#each responsibilities}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            {{else}}
              <p>No key achievements provided.</p>
            {{/if}}
          </div>
        {{/each}}
        <br />
        <hr />
      {{/if}}

      {{#if education.length}}
        <h2 class="section-title">EDUCATION</h2>
        {{#each education}}
          <div class="education-item">
            <div class="education-details">
              <p><strong>{{degree}}</strong> {{institution}}</p>
              <span class="education-dates">{{year}}</span>
            </div>
            <p>{{score}}</p>
          </div>
        {{/each}}
        <br />
        <hr />
      {{/if}}

      {{#if skills.length}}
        <h2 class="section-title">SKILLS</h2>
        <div class="skills-container">
          {{#each skills}}
            <div class="skills-column">
              {{#if name}}{{name}}{{else}}{{this}}{{/if}}
            </div>
          {{/each}}
        </div>
        <br />
        <hr />
      {{/if}}

      {{#if customsections.length}}
        {{#each customsections}}
          <h2 class="section-title">{{title}}</h2>
          {{#each items}}
            <div class="education-item">
              <div class="education-details">
                <p><strong>{{title}}</strong>{{#if location}}
                    |
                    {{location}}{{/if}}</p>
                <span class="education-dates">{{date}}</span>
              </div>
              <p>{{description}}</p>
            </div>
          {{/each}}
          <br />
          <hr />
        {{/each}}
      {{/if}}
    </div>
  </body>
</html>