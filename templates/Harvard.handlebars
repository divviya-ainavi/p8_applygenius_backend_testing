<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{name}} Resume</title>
    <style>
      body { font-family: Arial, sans-serif; background-color: #fff; color:
      #000; line-height: 1.2; font-size: 9.5px; } p { margin: 0px 0px 0px 0px; }
      .resume-container { max-width: 800px; margin: auto; background: #fff;
      padding: 10px; } .header { text-align: center; font-size: 20px;
      font-weight: bold; color: #000; margin-bottom: 5px; } .contact-info {
      display: flex; flex-wrap: wrap; /* Allows wrapping only when needed */
      align-items: center; justify-content: center; gap: 10px; font-size: 9.5px;
      color: #000; text-align: center; } .contact-info a { color: #4da6ff;
      text-decoration: none; word-break: break-word; /* Ensures long text (like
      links) wraps */ } .contact-info a:hover { text-decoration: underline; }
      .icon { font-size: 9.5px; margin-right: 5px; } /* Ensure each item doesn't
      take too much space */ .contact-info > * { flex-shrink: 1; /* Prevents
      elements from stretching too much */ min-width: auto; max-width: 100%; /*
      Ensures the items stay within bounds */ text-align: center; } hr { border:
      1px solid #555; margin: 3px 0; } .section-title { margin-bottom: 3px;
      font-size: 11.5px; font-weight: bold; color: #000; } .info { font-size:
      9.5px; color: #000; } .experience-item, .skills-list { margin-bottom: 8px;
      } .experience-item h4 { margin: 3px 0; display: flex; justify-content:
      space-between; font-size: 9.5px; } .experience-dates { font-weight: bold;
      font-size: 9.5px; } .skills-container { display: flex; flex-wrap: wrap;
      justify-content: space-between; padding: 5px 0; } .skills-column {
      text-align: left; padding: 3px 0; } .bullet-list { list-style: none; /*
      Remove default bullets */ padding-left: 0px; /* Maintain indentation */
      margin: 0; } .bullet-list li { position: relative; padding-left: 15px; /*
      Space for the custom bullet */ margin-bottom: 2px; /* Space between bullet
      points */ font-size: 9.5px; } .bullet-list li::before { content: "●"; /*
      Unicode bullet symbol */ color: black; /* Change this to your desired
      bullet color */ font-size: 5px; /* Adjust bullet size */ position:
      absolute; left: 0; top: 5; } .education-item { display: flex;
      flex-direction: column; /* Stack items vertically */ margin-bottom: 5px; }
      .education-details { display: flex; justify-content: space-between; /*
      Degree on the left, Date on the right */ align-items: center; }
      .education-details p { font-size: 9.5px; } .education-dates { white-space:
      nowrap; /* Prevent wrapping */ text-align: right; /* Align text to the
      right */ min-width: 120px; /* Ensures consistent width */ color: #555; /*
      Subtle color */ font-size: 9.5px; } /* Page break handling for Puppeteer
      */ .experience-item, .education-item, .skills-column, .custom-block {
      page-break-inside: avoid; break-inside: avoid; } .custom-section-block {
      margin-top: 5px; page-break-inside: avoid; } .custom-description-list {
      list-style: none; padding-left: 0; margin-top: 3px; }
      .custom-description-list li { position: relative; padding-left: 15px;
      margin-bottom: 2px; font-size: 9.5px; text-align: justify; }
      .custom-description-list li::before { content: "●"; color: black;
      font-size: 8px; position: absolute; left: 0; top: 2px; } .bullet-list li {
      page-break-inside: avoid; break-inside: avoid; } .skills-wrapper {
      page-break-inside: avoid; break-inside: avoid; } .summary-text {
      font-size: 9.5px; line-height: 1.4; margin: 0; color: #000; text-align:
      justify; /* ✅ improves alignment across lines */ }

    </style>
  </head>
  <body>
    <div class="resume-container">
      <div class="header">{{name}}</div>
      <div class="contact-info">
        {{#if location}}<span>{{location}}</span>{{/if}}
        {{#if email}}<span>{{email}}</span>{{/if}}
        {{#if phoneNumber}}<span>{{phoneNumber}}</span>{{/if}}
        {{#if jobTitle}}<strong>{{jobTitle}}</strong>{{/if}}
        {{#if linkedin}}<span>{{linkedin}}</span>{{/if}}
      </div>

      {{#if summary}}
        <h2 class="section-title">SUMMARY</h2>
        <hr />
        <p class="summary-text">{{summary}}</p>
      {{/if}}

      {{#if experience.length}}
        <div class="section-block">
          <h2 class="section-title">EXPERIENCE</h2>
          <hr />
          {{#each experience}}
            <div class="experience-item">
              <h4>
                {{title}}{{#if company}} | {{company}}{{/if}}
                <span class="experience-dates">{{duration}}</span>
              </h4>
              {{#if responsibilities.length}}
                <ul class="bullet-list">
                  {{#each responsibilities}}
                    <li class="summary-text">{{this}}</li>
                  {{/each}}
                </ul>
              {{else}}
                <p>No key achievements provided.</p>
              {{/if}}
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if education.length}}
        <div class="custom-block">
          <h2 class="section-title">EDUCATION</h2>
          <hr />
          {{#each education}}
            <div class="education-item">
              <div class="education-details">
                <p><strong>{{degree}}</strong> {{institution}}</p>
                <span class="education-dates">{{year}}</span>
              </div>
              <p class="summary-text">{{score}}</p>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if skills.length}}
        <div class="custom-block">
          <h2 class="section-title">SKILLS</h2>
          <hr />
          {{! <div class="skills-wrapper"> }}
          <!-- ✅ add this -->
          {{! <div class="skills-container"> }}
          {{#each skills}}
            {{! <div class="skills-column"> }}
            <ul class="bullet-list">
              <li> {{#if name}}{{name}}{{else}}{{this}}{{/if}}</li>
            </ul>
            {{! </div> }}
          {{/each}}
          {{! </div> }}
          {{! </div> }}
          <!-- ✅ close wrapper -->
        </div>
      {{/if}}

      {{!-- {{#if customsections.length}}
        {{#each customsections}}
        <div class="section-block">
          <h2 class="section-title">{{title}}</h2>
          {{#each items}}
            <div class="education-item">
              {{#if (orNotEmpty title location date)}}
              <div class="education-details">
                <p>{{#if title}}<strong>{{title}}</strong>{{/if}}{{#if location}} | {{location}}{{/if}}</p>
               {{#if date}} <span class="education-dates">{{date}}</span>{{/if}}
              </div>
              {{/if}}   
              <p class="summary-text">{{description}}</p>
            </div>
        </div>
          {{/each}}
          <br />
          <hr />
        {{/each}}
      {{/if}} --}}

      {{#if customsections.length}}
        {{#each customsections}}
          <div class="section-block custom-section-block">
            <h2 class="section-title">{{title}}</h2>
            <hr />
            <ul class="custom-description-list">
              {{#each items}}
                {{#if (orNotEmpty title location date)}}

                  <div class="education-details">
                    <p>
                      {{#if title}}<strong>{{title}}</strong>{{/if}}
                      {{#if location}} | {{location}}{{/if}}
                    </p>
                    {{#if date}}
                      <span class="education-dates">{{date}}</span>
                    {{/if}}
                  </div>
                  <p class="summary-text">{{description}}</p>

                {{else}}
                  {{#if description}}
                    <li>{{description}}</li>
                  {{/if}}
                {{/if}}
              {{/each}}
            </ul>
          </div>
        {{/each}}
      {{/if}}

    </div>
  </body>
</html>